/* Additional Smooth Animations & Polish */
@keyframes modalScale {
  from {
    opacity: 0;
    transform: scale(0.95) translateY(10px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.animate-fade-in {
  animation: modalScale 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: #0d121d;
}
::-webkit-scrollbar-thumb {
  background: #232d42;
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: #d4af37;
}

/* Empty Admin portal styling */
.admin-empty-portal {
  min-height: 100vh;
  background: #080b11;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  text-align: center;
}

.admin-empty-card {
  background: #121826;
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 20px;
  padding: 60px 40px;
  max-width: 540px;
  width: 100%;
  box-shadow: 0 20px 50px rgba(0,0,0,0.5);
}



/* ======================================================================
   VIBENOWW OFFICIAL LOGO & ELECTRIC GRADIENT BRAND THEME
   Palette: Electric Cyan (#00D2FF) -> Royal Blue (#0072FF) -> 
            Neon Violet (#7928CA) -> Vivid Magenta (#D946EF)
   Midnight Canvas: #050814 / #0A0E1F
   ====================================================================== */

:root {
  --color-midnight: #050814 !important;
  --color-navy-dark: #0a0e1f !important;
  --color-navy-card: #0e152d !important;
  --color-navy-surface: #141c3b !important;
  
  --vn-cyan: #00d2ff !important;
  --vn-blue: #0072ff !important;
  --vn-purple: #7928ca !important;
  --vn-magenta: #d946ef !important;
  --vn-pink: #ec4899 !important;

  --color-gold-primary: #00d2ff !important;
  --color-gold-warm: #00b4d8 !important;
  --color-gold-dark: #0284c7 !important;
  --color-gold-light: #38bdf8 !important;
  --color-gold-glow: rgba(0, 210, 255, 0.45) !important;
  --color-gold-bg: rgba(0, 210, 255, 0.12) !important;
  --primary-color: #00d2ff !important;
  --primary-hover: #0072ff !important;
  --color-border-gold: rgba(0, 210, 255, 0.45) !important;
  --shadow-gold: 0 10px 30px rgba(0, 210, 255, 0.35) !important;

  --vn-gradient: linear-gradient(135deg, #00d2ff 0%, #0072ff 35%, #7928ca 70%, #d946ef 100%) !important;
  --vn-gradient-hover: linear-gradient(135deg, #38bdf8 0%, #2563eb 35%, #9333ea 70%, #ec4899 100%) !important;
  --vn-gradient-subtle: linear-gradient(135deg, rgba(0, 210, 255, 0.15) 0%, rgba(121, 40, 202, 0.12) 50%, rgba(217, 70, 239, 0.15) 100%) !important;
  --vn-glow: 0 0 25px rgba(0, 210, 255, 0.45), 0 0 40px rgba(217, 70, 239, 0.3) !important;
}

::selection {
  background-color: #00d2ff !important;
  color: #050814 !important;
}

/* Header & Navbar Logo */
.header--logo {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  text-decoration: none !important;
  cursor: pointer !important;
}

.header--logo-image,
.brand-logo-icon {
  width: 48px !important;
  height: 32px !important;
  border-radius: 8px !important;
  object-fit: contain !important;
  padding: 2px !important;
  background: rgba(15, 23, 42, 0.45) !important;
  border: 1.5px solid rgba(0, 210, 255, 0.5) !important;
  box-shadow: 0 0 16px rgba(0, 210, 255, 0.4), 0 0 25px rgba(217, 70, 239, 0.25) !important;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
  display: inline-block !important;
  vertical-align: middle !important;
  flex-shrink: 0 !important;
}

.header--logo:hover .header--logo-image,
.header--logo:hover .brand-logo-icon {
  transform: scale(1.08) rotate(-1deg) !important;
  border-color: #00d2ff !important;
  box-shadow: 0 0 25px rgba(0, 210, 255, 0.7), 0 0 35px rgba(217, 70, 239, 0.45) !important;
