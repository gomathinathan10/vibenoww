# ======================================================================
# VibeNoww Production Environment Variables for Hostinger
# ======================================================================

NODE_ENV=production
PORT=5001

# Web Application URLs
FRONTEND_URL=https://vibenoww.com
ALLOWED_ORIGINS=https://vibenoww.com,https://www.vibenoww.com

# Client Application Variables
VITE_APP_NAME="VibeNoww"
VITE_APP_URL="https://vibenoww.com"
VITE_API_BASE_URL="/api"

# MySQL Database Configuration (Hostinger hPanel Database)
# Hostinger prefixes DB_NAME and DB_USER with your account prefix (e.g. u123456789_)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_vibenoww_db
DB_USER=u123456789_vibenoww_user
DB_PASSWORD=your_hostinger_mysql_password
DB_CONNECTION_LIMIT=10

# Security & JWT Token Secrets
JWT_SECRET=vibenoww_production_jwt_secret_key_2026
